# Copy this file to `.env` in the project root – it is loaded automatically.
# `.env` is gitignored so credentials stay local.

# --- Required ---------------------------------------------------------------

# Hostname or IP of your MQTT broker (e.g. the Mosquitto add-on in Home Assistant).
MQTT_HOST=homeassistant.local

# Credentials of an MQTT user (Home Assistant: Settings → People → Users).
MQTT_USERNAME=air2mqtt
MQTT_PASSWORD=change-me

# --- Optional (defaults shown) ----------------------------------------------

#MQTT_PORT=1883
#MQTT_TLS=false
#MQTT_KEEPALIVE=60

# Topic prefix for state and availability messages.
#MQTT_BASE_TOPIC=air2mqtt

# Must match the discovery prefix configured in Home Assistant.
#HA_DISCOVERY_PREFIX=homeassistant

# Unique, stable ID of this node (default: the hostname). Used in topics and entity IDs.
#DEVICE_ID=livingroom

# Device name shown in Home Assistant.
#DEVICE_NAME=Air2MQTT

# Seconds between two measurements (minimum 5).
#READ_INTERVAL=60

# UART port of the MH-Z19 CO2 sensor.
#MHZ19_PORT=/dev/serial0

# DEBUG, INFO, WARNING or ERROR.
#LOG_LEVEL=INFO
